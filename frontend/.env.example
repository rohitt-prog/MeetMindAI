# Backend API Configuration
VITE_API_BASE_URL=http://localhost:8000

# Firebase Client Web Configuration (Authentication)
# Obtain these values from Firebase Console -> Project Settings -> General -> Your Apps (Web)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=meetmindai-9eac4.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=meetmindai-9eac4
VITE_FIREBASE_STORAGE_BUCKET=meetmindai-9eac4.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id_here

# Optional Demo Account Settings
# By default, "Explore Demo Account" uses Firebase Anonymous Authentication.
# Ensure "Anonymous" is enabled in Firebase Console -> Authentication -> Sign-in method.
# Alternatively, configure a dedicated demo account with email/password:
# VITE_FIREBASE_DEMO_EMAIL=demo@meetmind.ai
# VITE_FIREBASE_DEMO_PASSWORD=your_demo_password_here
