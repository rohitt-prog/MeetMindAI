ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Firebase Admin Configuration (Cloud Firestore & Authentication)
# Provide either FIREBASE_CREDENTIALS_PATH (path to serviceAccountKey.json)
# or FIREBASE_CREDENTIALS_JSON (raw JSON string of service account key).
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json
# FIREBASE_CREDENTIALS_JSON={"type": "service_account", ...}
FIRESTORE_COLLECTION_MEETINGS=meetings
FIREBASE_AUTH_ENABLED=true

# API Abuse & Resource Protection (Phase 12)
RATE_LIMIT_ANALYZE=10/minute
RATE_LIMIT_CLARIFY=10/minute
RATE_LIMIT_PDF=20/minute
# RATE_LIMIT_REDIS_URL=redis://localhost:6379/0
# RATE_LIMIT_FAIL_CLOSED=true
# RATE_LIMIT_REDIS_REQUIRED=false

MAX_REQUEST_BODY_BYTES=1048576
MAX_TRANSCRIPT_CHARS=100000
