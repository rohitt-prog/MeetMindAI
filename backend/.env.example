GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Firebase Admin Configuration (Cloud Firestore & Authentication)
# Provide either FIREBASE_CREDENTIALS_PATH (path to serviceAccountKey.json)
# or FIREBASE_CREDENTIALS_JSON (raw JSON string of service account key).
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json
# FIREBASE_CREDENTIALS_JSON={"type": "service_account", ...}
FIRESTORE_COLLECTION_MEETINGS=meetings
FIREBASE_AUTH_ENABLED=true
